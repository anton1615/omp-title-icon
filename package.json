{
  "name": "omp-title-icon",
  "version": "0.1.0",
  "description": "Windows Terminal title takeover extension for Oh My Pi/Pi coding agent sessions.",
  "type": "module",
  "main": "./src/extension.ts",
  "exports": {
    ".": "./src/extension.ts"
  },
  "files": [
    "src/**",
    ".claude-plugin/marketplace.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run test && bun run typecheck"
  },
  "keywords": [
    "omp-package",
    "omp-extension",
    "pi-extension",
    "windows-terminal",
    "title",
    "session-title",
    "ask",
    "idle",
    "running"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/anton1615/omp-title-icon.git"
  },
  "homepage": "https://github.com/anton1615/omp-title-icon#readme",
  "bugs": {
    "url": "https://github.com/anton1615/omp-title-icon/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^14.1.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.2"
  },
  "omp": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
